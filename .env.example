# RetroShelf configuration — copy to .env and edit.
# REQUIRED -------------------------------------------------------------------
KAVITA_BASE_URL=http://kavita:5000
KAVITA_OPDS_URL=http://kavita:5000/api/opds/YOUR_AUTH_KEY

# OPTIONAL -------------------------------------------------------------------
APP_PORT=8099
TZ=America/Chicago

# Stable secret so bookmarked /download links survive restarts (random if unset).
# BRIDGE_ID_SECRET=set-a-stable-random-string

# Optional access key: append ?key=... to the URL (or send X-Access-Key header).
# BRIDGE_ACCESS_KEY=changeme

# Optional direct-LAN IP allowlist (NOT proxy-aware; uses socket peer address).
# ALLOWED_IPS=192.168.1.0/24,10.0.0.5

SHOW_COVERS=true
CACHE_FEEDS_SECONDS=300
CACHE_BOOKS=false
PDF_DISPOSITION=inline
EPUB_DISPOSITION=attachment
LOG_LEVEL=info
