# RetroShelf configuration — copy to .env and edit.
# REQUIRED (at least one feed) -----------------------------------------------
KAVITA_BASE_URL=http://kavita:5000
KAVITA_OPDS_URL=http://kavita:5000/api/opds/YOUR_AUTH_KEY
# Name shown for the KAVITA_OPDS_URL feed in the portal menu (default "Library").
# KAVITA_FEED_NAME=My Library

# PORTAL: aggregate MULTIPLE OPDS libraries. The home page becomes a menu.
# Comma- or newline-separated "Name|URL" entries (name optional). KAVITA_OPDS_URL
# (if set) is the primary/first library; these are added after it.
# OPDS_FEEDS=Project Gutenberg|https://www.gutenberg.org/ebooks.opds/, ManyBooks|https://manybooks.net/opds

# OPTIONAL -------------------------------------------------------------------
APP_PORT=8099
TZ=America/Chicago

# Stable secret so bookmarked /download links survive restarts (random if unset).
# BRIDGE_ID_SECRET=set-a-stable-random-string

# Optional access key. Open the bridge ONCE as http://host:8099/?key=YOURKEY —
# the browser is then handed an HttpOnly cookie and every link works without the
# key in the URL (so it stays out of the address bar, Referer, and access logs).
# Scripts and OPDS readers can send the X-Access-Key header instead.
# BRIDGE_ACCESS_KEY=changeme

# Optional direct-LAN IP allowlist (NOT proxy-aware; uses socket peer address).
# ALLOWED_IPS=192.168.1.0/24,10.0.0.5

# Opt-in multi-account login + profiles. Off (default) → today's behavior: no
# login, global reading state, the optional BRIDGE_ACCESS_KEY/ALLOWED_IPS gate.
# On → the first visit creates an admin account at /setup, /login becomes the
# gate (superseding BRIDGE_ACCESS_KEY), and reading state is per-profile. Set a
# stable BRIDGE_ID_SECRET so sessions survive restarts. Login is brute-force
# throttled (per-device lockout + per-username delay, in-process, no config);
# the session cookie is marked Secure when BRIDGE_PUBLIC_URL is https. Behind a
# reverse proxy, let the proxy do auth (the throttle + IP-allowlist see only the
# proxy's address).
# ACCOUNTS_ENABLED=true

SHOW_COVERS=true
CACHE_FEEDS_SECONDS=300
CACHE_BOOKS=false
PDF_DISPOSITION=inline
EPUB_DISPOSITION=attachment
LOG_LEVEL=info

# For generic (non-Kavita) OPDS servers that host downloads/covers on other
# hosts/CDNs, allowlist those origins (comma-separated). Kavita does not need this.
# EXTRA_UPSTREAM_ORIGINS=https://files.example.com,https://cdn.example.com

# Where the Reading List + download history JSON is stored (the /config volume).
STATE_DIR=/config

# ADVANCED / rarely needed -----------------------------------------------------
# Public base URL of this bridge. Set it to your https:// address when RetroShelf
# is served over HTTPS (behind a reverse proxy): the account session cookie is
# then marked Secure. On a plain-HTTP LAN, leave it unset.
# BRIDGE_PUBLIC_URL=https://retroshelf.example.com

# Cover disk-cache root (the /cache volume) and the transcode bounds old Safari
# needs. Covers are downscaled to COVER_MAX_EDGE px on the long edge and encoded
# as baseline JPEG at COVER_JPEG_QUALITY. Defaults are fine for old iPads.
# CACHE_DIR=/cache
# COVER_MAX_EDGE=320
# COVER_JPEG_QUALITY=80

# Override the User-Agent sent on upstream OPDS/cover/download fetches (some
# public feeds behind a CDN want a browser-like UA; the built-in default already
# is one). Leave unset unless a feed rejects the default.
# UPSTREAM_USER_AGENT=Mozilla/5.0 (compatible; RetroShelf)
