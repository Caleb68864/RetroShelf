# RetroShelf configuration — copy to .env and edit.
# REQUIRED (at least one feed) -----------------------------------------------
KAVITA_BASE_URL=http://kavita:5000
KAVITA_OPDS_URL=http://kavita:5000/api/opds/YOUR_AUTH_KEY
# Name shown for the KAVITA_OPDS_URL feed in the portal menu (default "Library").
# KAVITA_FEED_NAME=My Library

# PORTAL: aggregate MULTIPLE OPDS libraries. The home page becomes a menu.
# Comma- or newline-separated "Name|URL" entries (name optional). KAVITA_OPDS_URL
# (if set) is the primary/first library; these are added after it.
# OPDS_FEEDS=Project Gutenberg|https://www.gutenberg.org/ebooks.opds/, ManyBooks|https://manybooks.net/opds

# OPTIONAL -------------------------------------------------------------------
APP_PORT=8099
TZ=America/Chicago

# Stable secret so bookmarked /download links survive restarts (random if unset).
# BRIDGE_ID_SECRET=set-a-stable-random-string

# Optional access key: append ?key=... to the URL (or send X-Access-Key header).
# BRIDGE_ACCESS_KEY=changeme

# Optional direct-LAN IP allowlist (NOT proxy-aware; uses socket peer address).
# ALLOWED_IPS=192.168.1.0/24,10.0.0.5

SHOW_COVERS=true
CACHE_FEEDS_SECONDS=300
CACHE_BOOKS=false
PDF_DISPOSITION=inline
EPUB_DISPOSITION=attachment
LOG_LEVEL=info

# For generic (non-Kavita) OPDS servers that host downloads/covers on other
# hosts/CDNs, allowlist those origins (comma-separated). Kavita does not need this.
# EXTRA_UPSTREAM_ORIGINS=https://files.example.com,https://cdn.example.com
